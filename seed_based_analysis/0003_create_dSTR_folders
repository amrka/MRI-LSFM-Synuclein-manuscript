    echo "you pass the folder that contains bids dir"
    echo ""
    echo "Usage:"
    echo ">>> ./0003_create_dSTR_folders.sh /Users/aeed/Documents/Work/M83_clearing/Manuscript_analysis"
    echo ">>> ./0003_create_dSTR_folders.sh /srv/menon/Work/Brown_Vaccht"
